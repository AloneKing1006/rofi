#!/usr/bin/env bash

ROFI_CONFIG="$HOME/.config/rofi/config.rasi"

# Display menu
menu() {
    local prompt="$1"
    shift

    printf '%s\n' "$@" | rofi \
        -config "$ROFI_CONFIG" \
        -dmenu \
        -i \
        -no-custom \
        -l 4 \
        -p "$prompt" \
        -theme-str '
            element {
                padding: 3px;
            }

            element-text {
                font: "JetBrainsMono Nerd Font 11";
                horizontal-align: 0.0;
                vertical-align: 0.5;
                padding: 0px 0px 0px 1.5em;
            }
        '
}

# Main power menu
choice=$(menu "Power" \
    "󰍃  Logout" \
    "󰑓  Reboot" \
    "󰐥  Poweroff" \
    "󰅖  Cancel")

# Handle cancellation
[[ -z "$choice" ]] && exit 0

case "$choice" in
    "󰍃  Logout")
        hyprctl dispatch 'hl.dsp.exit()'
        ;;

    "󰑓  Reboot")
        systemctl reboot
        ;;

    "󰐥  Poweroff")
        systemctl poweroff
        ;;

    "󰅖  Cancel")
        exit 0
        ;;

    *)
        exit 1
        ;;
esac

